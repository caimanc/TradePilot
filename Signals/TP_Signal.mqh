#ifndef __TP_SIGNAL_MQH__
#define __TP_SIGNAL_MQH__

//+------------------------------------------------------------------+
//| Clase base para todas las señales                                |
//+------------------------------------------------------------------+
class CTPSignal
{
protected:

   bool m_buy;
   bool m_sell;

public:

   //--------------------------------------------------
   // Constructor
   //--------------------------------------------------

   CTPSignal()
   {
      m_buy  = false;
      m_sell = false;
   }

   //--------------------------------------------------
   // Destructor
   //--------------------------------------------------

   virtual ~CTPSignal()
   {
   }

   //--------------------------------------------------
   // Inicialización
   //--------------------------------------------------

   virtual bool Initialize()
   {
      return true;
   }

   //--------------------------------------------------
   // Actualización
   //--------------------------------------------------

   virtual void Update() = 0;

   //--------------------------------------------------
   // Reiniciar señales
   //--------------------------------------------------

   void Reset()
   {
      m_buy  = false;
      m_sell = false;
   }

   //--------------------------------------------------
   // Getters
   //--------------------------------------------------

   bool Buy() const
   {
      return m_buy;
   }

   bool Sell() const
   {
      return m_sell;
   }
};

#endif