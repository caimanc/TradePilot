#ifndef __TP_SIGNAL_MQH__
#define __TP_SIGNAL_MQH__

//+------------------------------------------------------------------+
//| Clase base para señales                                          |
//+------------------------------------------------------------------+
class CTPSignal
{
protected:

   bool m_buy;
   bool m_sell;

public:

   //--------------------------------------------------
   // Constructor
   //--------------------------------------------------

   CTPSignal()
   {
      Reset();
   }

   //--------------------------------------------------
   // Reset
   //--------------------------------------------------

   void Reset()
   {
      m_buy  = false;
      m_sell = false;
   }

   //--------------------------------------------------
   // Actualizar señal
   //--------------------------------------------------

   virtual bool Update()
   {
      Reset();
      return true;
   }

   //--------------------------------------------------
   // Getters
   //--------------------------------------------------

   bool Buy() const
   {
      return m_buy;
   }

   bool Sell() const
   {
      return m_sell;
   }
};

#endif